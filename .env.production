# Production environment. Loaded by Expo CLI / EAS Build when NODE_ENV=production.
# Reemplazá esta URL por la del backend real antes de publicar un build de producción.
# Debe ser HTTPS: api.ts rechaza una base URL de producción que no use https.
EXPO_PUBLIC_API_BASE_URL=https://api.todoapp.example.com
EXPO_PUBLIC_API_TIMEOUT_MS=20000
